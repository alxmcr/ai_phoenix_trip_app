// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Review
// - Relationship: One review can have many actionables, recommendations, and sentiments
model Review {
  review_id       String           @id @default(uuid())
  rating          Int
  start_date      DateTime
  end_date        DateTime
  origin          String
  destination     String
  company_name    String
  email           String
  age_group       String
  trip_type       String
  description     String
  transport_mode  String
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  actionables     Actionable[]
  recommendations Recommendation[]
  sentiments      Sentiment[]
}

// Actionable
// - Relationship: One review can have many actionables
model Actionable {
  actionable_id String   @id @default(uuid())
  review_id     String
  review        Review   @relation(fields: [review_id], references: [review_id])
  priority      String
  department    String
  category      String
  source_aspect String
  title         String
  description   String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

// Recommendation
model Recommendation {
  recommendation_id String   @id @default(uuid())
  review_id         String
  review            Review   @relation(fields: [review_id], references: [review_id])
  data_driven       Boolean
  target_area       String
  effort_level      String
  title             String
  description       String
  impact            String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

// Sentiment
model Sentiment {
  sentiment_id String   @id @default(uuid())
  review_id    String
  review       Review   @relation(fields: [review_id], references: [review_id])
  score        Int
  emotion_tone String
  label        String
  summary      String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}
