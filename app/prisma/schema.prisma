generator client {
  provider = "prisma-client-js"
  output   = "app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Actionable {
  actionable_id String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  review_id     String?   @db.Uuid
  title         String?
  description   String?
  priority      String?
  department    String?
  category      String?
  source_aspect String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  review        Review?   @relation(fields: [review_id], references: [review_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([review_id], map: "idx_actionable_review_id")
}

model Recommendation {
  recommendation_id String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  review_id         String?   @db.Uuid
  title             String?
  description       String?
  impact            String?
  target_area       String?
  effort_level      String?
  data_driven       Boolean?
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)
  review            Review?   @relation(fields: [review_id], references: [review_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([review_id], map: "idx_recommendation_review_id")
}

model Review {
  review_id       String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email           String?
  age_group       String?
  trip_type       String?
  description     String?
  transport_mode  String?
  rating          Int?
  company_name    String?
  origin          String?
  destination     String?
  start_date      DateTime?        @db.Date
  end_date        DateTime?        @db.Date
  created_at      DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?        @default(now()) @db.Timestamptz(6)
  actionables     Actionable[]
  recommendations Recommendation[]
  sentiments      Sentiment[]

  @@index([review_id], map: "idx_review_id")
}

model Sentiment {
  sentiment_id String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  review_id    String?   @db.Uuid
  score        Decimal?  @db.Decimal
  label        String?
  summary      String?
  emotion_tone String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
  review       Review?   @relation(fields: [review_id], references: [review_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([review_id], map: "idx_sentiment_review_id")
}
