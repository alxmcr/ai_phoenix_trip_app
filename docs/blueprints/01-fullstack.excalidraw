      "text": "'use server'\n \nimport { redirect } from 'next/navigation'\n \nexport async function createUser(prevState: any, formData: FormData) {\n  const res = await fetch('https://...')\n  const json = await res.json()\n \n  if (!res.ok) {\n    return { message: 'Please enter a valid email' }\n  }\n \n  redirect('/dashboard')\n}",
